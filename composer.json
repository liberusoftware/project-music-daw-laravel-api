{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "liberusoftware/project-music-daw-laravel-api",
    "type": "project",
    "description": "Laravel API backend for Liberu Music Daw",
    "license": "MIT",
    "require": {
        "bursteri/socialstream": "^7.0.0",
        "laravel/framework": "^13.38.0",
        "laravel/horizon": "^5.50.1",
        "laravel/jetstream": "^5.5.3",
        "laravel/octane": "^2.22.0",
        "laravel/reverb": "^1.12.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31.0",
        "laravel/tinker": "^3.0.2",
        "liberusoftware/activity-comments": "1.4.2",
        "liberusoftware/analytics-contracts": "^1.0",
        "liberusoftware/analytics-core": "1.4.1",
        "liberusoftware/analytics-google": "1.4.1",
        "liberusoftware/analytics-meta": "1.4.1",
        "liberusoftware/api-access": "1.4.1",
        "liberusoftware/application": "1.4.1",
        "liberusoftware/audit": "1.4.1",
        "liberusoftware/currency-context": "1.4.1",
        "liberusoftware/developer-experience": "1.4.1",
        "liberusoftware/feature-flags": "1.4.1",
        "liberusoftware/files-media": "1.4.1",
        "liberusoftware/identity-core": "1.4.1",
        "liberusoftware/identity-socialstream": "1.4.1",
        "liberusoftware/import-export": "1.4.1",
        "liberusoftware/integrations": "1.4.1",
        "liberusoftware/jetstream-bridge": "1.4.1",
        "liberusoftware/localization-contracts": "^1.0",
        "liberusoftware/localization-core": "1.4.1",
        "liberusoftware/localization-mymemory": "1.4.1",
        "liberusoftware/module-manager": "1.4.8",
        "liberusoftware/music-audio-engine": "0.1.0",
        "liberusoftware/music-media-library": "0.1.0",
        "liberusoftware/music-media-library-api": "0.1.0",
        "liberusoftware/music-projects": "0.1.0",
        "liberusoftware/music-projects-api": "0.1.0",
        "liberusoftware/notifications": "1.4.1",
        "liberusoftware/observability": "1.4.1",
        "liberusoftware/organizations-teams": "1.4.1",
        "liberusoftware/profiles": "1.4.1",
        "liberusoftware/roles-permissions": "1.4.1",
        "liberusoftware/scheduler-queues": "1.4.1",
        "liberusoftware/search": "1.5.1",
        "liberusoftware/search-api": "1.4.1",
        "liberusoftware/sessions-devices": "1.4.1",
        "liberusoftware/settings": "1.4.1",
        "liberusoftware/tenancy": "1.2.2",
        "liberusoftware/two-factor-authentication": "1.4.1",
        "liberusoftware/users-roles": "1.0.0",
        "liberusoftware/webhooks": "1.4.1",
        "php": "^8.5",
        "spatie/laravel-activitylog": "^5.1.3",
        "spatie/laravel-backup": "^10.3.3",
        "spatie/laravel-passkeys": "^1.8.1",
        "spatie/laravel-permission": "^8.3.2",
        "spiral/roadrunner-cli": "^3.0.1",
        "spiral/roadrunner-http": "^4.2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.4.3"
    },
    "conflict": {
        "filament/filament": "*",
        "livewire/livewire": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "modules/*",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "@php artisan test"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "liberusoftware/composer-installer": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

{
    "name": "liberusoftware/music-audio-engine",
    "description": "Versioned Music engine graphs and project-pinned native handoff metadata.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "require": {
        "php": "^8.5",
        "php-64bit": "^8.5",
        "illuminate/support": "^13.38",
        "illuminate/validation": "^13.38",
        "liberusoftware/music-projects": "^0.1 || dev-main"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Music\\AudioEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Music\\AudioEngine\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.8",
        "pestphp/pest": "^5.3"
    },
    "extra": {
        "liberu": {
            "name": "music-audio-engine"
        },
        "laravel": {
            "providers": []
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "github-protocols": [
            "https"
        ]
    }
}
